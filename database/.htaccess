# Uygulama yerel verileri (ayarlar.json, enflasyon.db — TCMB API anahtarı içerir).
# Doğrudan web erişimi kapalıdır; kök .htaccess de /database/ yolunu engeller.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
