<?xml version="1.0" encoding="UTF-8"?>
<!--
  Uygulama yerel verileri (ayarlar.json, enflasyon.db). Doğrudan web erişimi kapalıdır
  (cek_ekleri/ ile aynı yöntem). Kök web.config'teki hiddenSegments de "database"
  yolunu engeller; bu dosya ikinci kat korumadır.
-->
<configuration>
  <system.webServer>
    <handlers accessPolicy="None" />
  </system.webServer>
</configuration>
