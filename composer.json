{
    "name": "lumen/siparis-sistemi",
    "description": "Lumen — LOGO Tiger uyumlu sipariş ve stok yönetim sistemi",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "dompdf/dompdf": "^3.1.6",
        "phpoffice/phpspreadsheet": "^2.4.7"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Lumen\\": "src/"
        }
    },
    "require-dev": {
        "rector/rector": "^1.0"
    }
}
