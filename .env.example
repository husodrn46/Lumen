# =====================================================================
#  Lumen — Ortam Yapılandırması (.env)
#  Bu dosyayı ".env" olarak kopyalayıp kendi değerlerinizle doldurun.
#  Kolay yol: tarayıcıda /kurulum.php sihirbazını çalıştırın (bu dosyayı sizin için yazar).
#  .env ASLA sürüm kontrolüne (git) eklenmez — gizli bilgiler içerir.
#  Değişken adları _baglanti_.inc'in getenv() ile okuduğu adlarla BİREBİR aynı olmalı.
# =====================================================================

# --- Veritabanı (Microsoft SQL Server — LOGO Tiger) ---
# Çalışma modu: logo (varsayılan) = LOGO Tiger veritabanına bağlı; lumen = bağımsız
# (Lumen'in kendi tabloları, LOGO gerekmez — geçiş sürüyor, bkz. docs/mimari/bagimsiz-lumen.md).
# Kurulumdan sonra değiştirmeyin: iki mod farklı tablolar kullanır.
LUMEN_VERI_KAYNAGI=logo

AKL_DB_SERVER=localhost
AKL_DB_NAME=LOGODB
AKL_DB_USER=kullanici_adi
AKL_DB_PASS=parolaniz
# Şifreli bağlantı (ODBC Driver 18). Boş: sürücü varsayılanı (18'de açık).
AKL_DB_ENCRYPT=
# SQL Server sertifikasına güven (kendinden imzalı sertifikalar için 1; geçerli
# bir sertifikanız varsa 0 yapın). Kurulum sihirbazı da 1 ile bağlanır.
AKL_DB_TRUST_CERT=1

# --- Firma / Dönem (LOGO tablo önekleri) ---
# LOGO tablo adı biçimi: LG_[FIRMA]_[DÖNEM]_TABLO   (örn: LG_001_02_ORFICHE)
#   FIRMA_PREFIX      = dönemsiz tablolar  (CLCARD, ITEMS...)          -> LG_001_
#   FIRMA_DONEM       = güncel dönem tabloları (ORFICHE, ORFLINE...)   -> LG_001_02_
#   FIRMA_DONEM_VIEW  = güncel dönem view'ları (STINVTOT, GNTOTCL...)  -> LV_001_02_
FIRMA_NO=1
FIRMA_PREFIX=LG_001_
FIRMA_DONEM=LG_001_02_
FIRMA_DONEM_VIEW=LV_001_02_
# Önceki dönem (geçmiş dönem sorguları için — opsiyonel)
FIRMA_ESKI_DONEM=LG_001_01_
FIRMA_ESKI_DONEM_VIEW=LV_001_01_
# Raporlarda/başlıklarda görünen firma adı
FIRMA_BASLIK=Firma Adınız

# --- Mağaza (hızlı satış) carisi ---
# Sabit "mağaza satış" carisinin LOGO LOGICALREF değeri. 0 = mağaza satış özelliği kapalı.
MAGAZA_CARI=0

# --- Loglama (opsiyonel) ---
# Boş bırakılırsa uygulama <proje>/logs klasörüne yazar (taşınabilir varsayılan).
# Özel konum için tam yol verin (örn: D:\Lumen_Loglar  veya  /var/log/lumen).
LOG_ROOT=
# Bu süreden (ms) uzun süren sorgular yavaş-sorgu olarak loglanır.
APP_SLOW_QUERY_MS=300
# Web isteğinde tek sorgu için üst süre (sn); takılan rapor oturumu kilitlemesin. Varsayılan 100.
LUMEN_SORGU_SINIRI=100

# --- Hata ayıklama (production'da false) ---
DEBUG_MODE=false

# --- Ters vekil (reverse proxy) ---
# Önünde IIS ARR / nginx gibi bir proxy varsa adresleri (virgülle). 127.0.0.1 ve ::1 her zaman güvenilir.
# Yalnız bu adreslerden gelen X-Forwarded-For dikkate alınır.
TRUSTED_PROXIES=

# --- Raporlar ---
# Pazarlamacı raporlarının varsayılan cari kodu ön eki (boş = tüm cariler)
PAZARLAMACI_CARI_ONEKI=
