<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gorev eklerine dogrudan web (HTTP) erisimi kapalidir.
  Dosyalar yalnizca gorev_ek_indir.php uzerinden, yetki kontrolu ile servis edilir.
  Canli ortam IIS oldugu icin asil koruma budur (.htaccess yalnizca Apache icin gecerli).
-->
<configuration>
  <system.webServer>
    <handlers accessPolicy="None" />
  </system.webServer>
</configuration>
